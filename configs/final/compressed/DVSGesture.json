{
  "models": [
    "custom"
  ],
  "datasets": [
    "DVSGesture"
  ],
  "homeostasis_modes": [
    "exponential"
  ],
  "weight_bits": [
    2,
    4
  ],
  "hidden_widths": [
    1024
  ],
  "learning_rules": [
    "hybrid"
  ],
  "custom_channels": [
    64,
    128,
    256,
    288,
    256
  ],
  "custom_pool_size": 4,
  "hidden_dropout": 0.2,
  "backbone_variant": "balanced_ei",
  "hidden_surrogate": "atan",
  "hidden_initial_row_sum": 1.0,
  "hidden_fan_in": 64,
  "calibrate_hidden": true,
  "init": "from_scratch",
  "seed": 42,
  "lr": 0.001,
  "model_learning_rates": {
    "custom": 0.001
  },
  "optimizer": "adam",
  "weight_decay": 0.0,
  "stdp_lr": 0.001,
  "weight_max": 1.0,
  "training_epochs": {
    "custom": 160
  },
  "validation_fraction": 0.1,
  "cifar_train_fraction": 0.9,
  "data_dir": "./datasets",
  "out_dir": "./results/new_runs",
  "device": "auto",
  "num_workers": 4,
  "cpu_threads": 4,
  "batch_sizes": {
    "MNIST": 64,
    "NMNIST": 32,
    "CIFAR10DVS": 16,
    "DVSGesture": 8
  },
  "dataset_profiles": {
    "MNIST": {
      "steps": 4,
      "resolution": 28,
      "pool_size": 2,
      "epochs": 60,
      "lr": 0.0005
    },
    "NMNIST": {
      "steps": 4,
      "resolution": 34,
      "event_transform": "log1p",
      "pool_size": 2,
      "epochs": 80,
      "lr": 0.0005
    },
    "CIFAR10DVS": {
      "steps": 8,
      "resolution": 64,
      "event_transform": "log1p",
      "pool_size": 4,
      "epochs": 200,
      "lr": 0.001
    },
    "DVSGesture": {
      "steps": 16,
      "resolution": 128,
      "event_transform": "log1p",
      "pool_size": 2,
      "epochs": 160,
      "lr": 0.001
    }
  },
  "threshold": {
    "baseline": 1.0,
    "delta": 0.05,
    "tau": 20.0,
    "eta": 0.01,
    "target_rate": 0.1,
    "rate_tau": 20.0,
    "minimum": 0.1,
    "maximum": 10.0
  },
  "monitoring": {
    "log_every_batches": 20,
    "log_every_seconds": 30.0,
    "probe_every_batches": 100,
    "probe_samples": 256,
    "warmup_batches": 100,
    "collapse_warmup_epochs": 2,
    "dead_patience": 3,
    "collapse_patience": 3,
    "collapse_fraction": 0.99,
    "collapse_accuracy_margin": 0.02,
    "min_loss_improvement": 0.01,
    "min_accuracy_improvement": 0.002,
    "early_stopping_patience": 15,
    "early_stopping_min_epochs": 10
  },
  "evaluate_on_collapse": false,
  "bp_row_normalize": false,
  "hidden_competition_size": 16,
  "gesture_validation_subjects": 4,
  "training_augmentation": {
    "DVSGesture": {
      "translate": 0.1,
      "rotation": 10,
      "scale_min": 0.85,
      "scale_max": 1.15
    },
    "CIFAR10DVS": {
      "translate": 0.125,
      "rotation": 10,
      "scale_min": 0.85,
      "scale_max": 1.15,
      "horizontal_flip": 0.5
    }
  },
  "bn_refit_batches": 16,
  "lr_schedule": "cosine",
  "lr_plateau": {
    "factor": 0.5,
    "patience": 3,
    "min_lr": 1e-05,
    "threshold": 0.002
  },
  "own_phase_restore_rng": false,
  "hybrid_stdp_period": 16,
  "hidden_winner_tiebreak": "margin",
  "hidden_winner_scope": "presentation",
  "classifier_projection": "common_offset",
  "split_seed": 42,
  "hybrid_stdp_granularity": "group",
  "freeze_backbone_parameters": false,
  "classifier_only_phase": false,
  "freeze_backbone_bn": false,
  "augmentation": {
    "enabled": false
  }
}
